{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "paths": {
      // The desktop's code, shared with the web page (protocol types, typing, taps).
      "@/*": ["../src/*"],
      // The chat server's pure parts the desktop's chat code imports.
      "@chat-server/*": ["../chat-server/*"],
      "~/*": ["./src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
